# Optional. Copy this file to .env to change settings; the values below are the defaults.
# Real environment variables always win over values in .env.

DATABASE_URL=postgresql+psycopg://certgen:certgen@localhost:5432/certgen
STORAGE_DIR=storage/certificates
MAX_RECIPIENTS_PER_JOB=1000
WORKER_POLL_INTERVAL_SECONDS=1
JOB_STALE_AFTER_SECONDS=300

# Used only by the test suite (its database name must end in _test).
TEST_DATABASE_URL=postgresql+psycopg://certgen:certgen@localhost:5432/certgen_test
